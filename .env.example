# ==============================================================================
# Seven Strokes CRM - Environment Configuration (.env)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in your document root:
#    cp .env.example .env
# 2. Update the credentials below with your real server details.
# 3. Keep .env private! It is already ignored by git to protect your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# Where to find these in cPanel:
# - Log into cPanel -> "Databases" -> "MySQL Databases".
# - DB_NAME: Under "Current Databases", copy your full database name (e.g. cpaneluser_crm7strokes).
# - DB_USER: Under "Current Users", copy your full database user name (e.g. cpaneluser_crmuser).
# - DB_PASS: The password you set when creating the database user.
# - DB_HOST: On 99% of cPanel servers, this is "localhost" or "127.0.0.1".
# - DB_PORT: Standard MySQL port is 3306.
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crm7strokes
DB_USER=root
DB_PASS=

# ------------------------------------------------------------------------------
# 2. Application & Hosting Configuration
# ------------------------------------------------------------------------------
# - BASE_URL: The full public URL of your CRM with a trailing slash.
#   Example: https://crm.7strokes.com/
# - CI_ENV: 
#   * 'production'  -> Suppresses all PHP error disclosures, optimizes performance (Recommended for Live).
#   * 'development' -> Displays detailed PHP error reporting for local debugging.
# ------------------------------------------------------------------------------
BASE_URL=https://crm.7strokes.com/
CI_ENV=production

# ------------------------------------------------------------------------------
# 3. Security & Telephony (Optional)
# ------------------------------------------------------------------------------
# - GROQ_API_KEY: Optional API key for AI call summary and transcription analysis.
# - PBX_ENDPOINT: Optional 3CX / Asterisk PBX endpoint URL for softphone dialer.
# ------------------------------------------------------------------------------
GROQ_API_KEY=
PBX_ENDPOINT=
